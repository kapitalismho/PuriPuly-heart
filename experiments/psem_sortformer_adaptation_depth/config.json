{
  "schema_version": 2,
  "experiment_id": "psem_sortformer_adaptation_depth_lean_v2",
  "authority_mode": "cost_bounded_hobby_engineering_probe",
  "material_execution_status": "ready",
  "sample_rate_hz": 16000,
  "native_frame_ms": 80,
  "slot_count": 4,
  "hidden_dimension": 192,
  "psem_input": {
    "dimension": 208,
    "field_order": [
      "final_temporal_hidden_192",
      "speaker_activity_logits_4",
      "slot_alive_4",
      "oracle_anchor_slot_one_hot_4",
      "selected_anchor_logit_1",
      "maximum_alive_non_anchor_logit_1",
      "state_reset_1",
      "model_evidence_delay_seconds_1"
    ],
    "model_evidence_delay_seconds": 1.04
  },
  "psem_head": {
    "input_layer_norm": true,
    "gru_layers": 1,
    "gru_hidden_size": 64,
    "causal": true,
    "outputs": ["anchor_present", "replacement_evidence"]
  },
  "arms": {
    "F0-FROZEN-FLOAT": {
      "trainable": []
    },
    "H-HEAD": {
      "trainable": ["psem_head"]
    },
    "T2-TOP": {
      "trainable": ["psem_head", "transformer_encoder.layers.16", "transformer_encoder.layers.17", "sortformer_activity_head"]
    },
    "TA-ALL-TEMPORAL": {
      "trainable": ["psem_head", "transformer_encoder.layers.0:17", "sortformer_activity_head"],
      "conditional": true
    }
  },
  "streaming": {
    "sequence_seconds": 30,
    "loss_warmup_seconds": 2,
    "chunk_audio_ms": 480,
    "algorithmic_evidence_delay_ms": 1040,
    "state_reset_policy": "declared_source_or_reset_boundary_only",
    "additional_future_context_allowed": false
  },
  "loss": {
    "replacement_weight": 1.0,
    "anchor_weight": 0.5,
    "native_sortformer_weight": 0.5,
    "psem_kind": "train_class_weighted_bce_with_logits",
    "native_kind": "checkpoint_arrival_order_four_slot_loss"
  },
  "sampling": {
    "manifest_epochs": 1,
    "windows_per_manifest": 4096,
    "source_time_uniform_fraction": 0.5,
    "replacement_positive_fraction": 0.25,
    "hard_negative_fraction": 0.25,
    "same_window_and_augmentation_identity_across_arms": true,
    "positive_families": ["clean_direct_different_speaker_handoff", "silence_gap_different_speaker_handoff", "overlap_takeover"],
    "hard_negative_families": ["stable_anchor_continuation", "same_speaker_silence_gap_resume", "overlap_return", "overlap_continuation"]
  },
  "augmentation": ["global_gain", "additive_non_speech_noise", "light_reverberation", "band_limitation"],
  "optimization": {
    "optimizer": "AdamW",
    "weight_decay": 0.0001,
    "gradient_clip_norm": 1.0,
    "warmup_fraction": 0.05,
    "micro_batch_size": 1,
    "gradient_accumulation_steps": 16,
    "effective_windows_per_optimizer_step": 16,
    "seed": 7301,
    "confirmation_seed_allowed": false,
    "short_smoke_maximum_optimizer_steps": 32,
    "official_maximum_optimizer_steps": 256,
    "checkpoint_policy": "final_optimizer_step",
    "deterministic_resume_required": false,
    "interrupted_run_policy": "discard_and_restart_arm_from_step_zero",
    "learning_rates": {
      "psem_head": 0.001,
      "sortformer_activity_head": 0.0001,
      "temporal_transformer": 0.00001
    }
  },
  "short_smoke": {
    "required_arms": ["H-HEAD", "T2-TOP"],
    "maximum_optimizer_steps": 32,
    "finite_forward_backward_update_required": true,
    "parameter_policy_must_hold": true,
    "loss_rule": "final_eight_step_mean_below_first_eight_step_mean"
  },
  "evaluation": {
    "replacement_thresholds": [0.5],
    "replacement_confirmation_ms": [500],
    "required_metrics": ["exclusive_non_anchor_contamination_seconds_per_active_speech_hour", "false_unnecessary_cuts", "missed_replacements"],
    "required_views": ["pooled", "AMI", "AliMeeting"],
    "bootstrap_required": false,
    "topology_matrix_required": false,
    "eval_candidates": "F0_plus_dev_selected_candidate",
    "eval_threshold_selection_allowed": false
  },
  "cost_budget": {
    "currency": "USD",
    "target_total": 15.0,
    "hard_stop_total": 30.0,
    "actual_and_projected_cost_receipt_required": true
  },
  "claim_boundary": "single_seed_short_budget_internal_engineering_direction_only"
}
