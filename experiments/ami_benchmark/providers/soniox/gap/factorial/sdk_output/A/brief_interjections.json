      "end_ms": 44580,
      "speaker": "1",
      "token_start_index": 219,
      "token_end_index": 225
    },
    {
      "text": " Well, that's your— it's this original one.",
      "start_ms": 44640,
      "end_ms": 46320,
      "speaker": "3",
      "token_start_index": 225,
      "token_end_index": 238
    },
    {
