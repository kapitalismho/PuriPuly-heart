      "end_ms": 16380,
      "speaker": "2",
      "token_start_index": 68,
      "token_end_index": 82
    },
    {
      "text": " Yeah.",
      "start_ms": 17100,
      "end_ms": 17280,
      "speaker": "1",
      "token_start_index": 82,
      "token_end_index": 84
    },
    {
      "text": " Actually, I noticed that. No one is. Right. All right.",
