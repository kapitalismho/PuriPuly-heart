      "end_ms": 22440,
      "speaker": "3",
      "token_start_index": 84,
      "token_end_index": 104
    },
    {
      "text": " Yeah. So.",
      "start_ms": 22620,
      "end_ms": 24000,
      "speaker": "1",
      "token_start_index": 104,
      "token_end_index": 108
    },
    {
      "text": " Okay. So I'll send it off to you, and then—",
