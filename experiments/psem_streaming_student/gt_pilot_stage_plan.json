{
  "schema_version": 1,
  "stages": [
    {
      "id": "check",
      "argv": [
        "wsl.exe",
        "-d",
        "Ubuntu",
        "--exec",
        "bash",
        "{workflow_root_wsl}/run_gt_pilot.sh",
        "check",
        "{workflow_root_wsl}/gt_pilot_config.json",
        "{run_root_wsl}"
      ],
      "timeout_seconds": 900,
      "required_outputs": [
        "check_receipt.json",
        "frozen_config.json"
      ]
    },
    {
      "id": "prepare",
      "argv": [
        "wsl.exe",
        "-d",
        "Ubuntu",
        "--exec",
        "bash",
        "{workflow_root_wsl}/run_gt_pilot.sh",
        "prepare",
        "{workflow_root_wsl}/gt_pilot_config.json",
        "{run_root_wsl}",
        "--authorize-material"
      ],
      "timeout_seconds": 900,
      "required_outputs": [
        "prepared_sources.pt",
        "prepare_receipt.json"
      ]
    },
    {
      "id": "evaluate_initial",
      "argv": [
        "wsl.exe",
        "-d",
        "Ubuntu",
        "--exec",
        "bash",
        "{workflow_root_wsl}/run_gt_pilot.sh",
        "evaluate",
        "{workflow_root_wsl}/gt_pilot_config.json",
        "{run_root_wsl}",
        "--which",
        "initial",
        "--authorize-material"
      ],
      "timeout_seconds": 1800,
      "required_outputs": [
        "initial_eval.json"
      ]
    },
    {
      "id": "train_pause_2",
      "argv": [
        "wsl.exe",
        "-d",
        "Ubuntu",
        "--exec",
        "bash",
        "{workflow_root_wsl}/run_gt_pilot.sh",
        "train",
        "{workflow_root_wsl}/gt_pilot_config.json",
        "{run_root_wsl}",
        "--pause-after",
        "2",
        "--authorize-material"
      ],
      "timeout_seconds": 1800,
      "required_outputs": [
        "checkpoint_latest.pt",
        "checkpoint_pause_update2.pt",
        "accounting.json",
        "update_ledger.jsonl"
      ]
    },
    {
      "id": "train_resume_780",
      "argv": [
        "wsl.exe",
        "-d",
        "Ubuntu",
        "--exec",
        "bash",
        "{workflow_root_wsl}/run_gt_pilot.sh",
        "train",
        "{workflow_root_wsl}/gt_pilot_config.json",
        "{run_root_wsl}",
        "--resume",
        "--authorize-material"
      ],
      "timeout_seconds": 7200,
      "required_outputs": [
        "checkpoint_latest.pt",
        "checkpoint_step_78.pt",
        "checkpoint_step_390.pt",
        "checkpoint_step_780.pt",
        "resume_witness.json",
        "accounting.json"
      ]
    },
    {
      "id": "evaluate_cal",
      "argv": [
        "wsl.exe",
        "-d",
        "Ubuntu",
        "--exec",
        "bash",
        "{workflow_root_wsl}/run_gt_pilot.sh",
        "evaluate",
        "{workflow_root_wsl}/gt_pilot_config.json",
        "{run_root_wsl}",
        "--which",
        "cal",
        "--authorize-material"
      ],
      "timeout_seconds": 1800,
      "required_outputs": [
        "cal_selection.json"
      ]
    },
    {
      "id": "evaluate_final",
      "argv": [
        "wsl.exe",
        "-d",
        "Ubuntu",
        "--exec",
        "bash",
        "{workflow_root_wsl}/run_gt_pilot.sh",
        "evaluate",
        "{workflow_root_wsl}/gt_pilot_config.json",
        "{run_root_wsl}",
        "--which",
        "final",
        "--authorize-material"
      ],
      "timeout_seconds": 1800,
      "required_outputs": [
        "final_eval.json"
      ]
    },
    {
      "id": "report",
      "argv": [
        "wsl.exe",
        "-d",
        "Ubuntu",
        "--exec",
        "bash",
        "{workflow_root_wsl}/run_gt_pilot.sh",
        "report",
        "{workflow_root_wsl}/gt_pilot_config.json",
        "{run_root_wsl}"
      ],
      "timeout_seconds": 600,
      "required_outputs": [
        "result.json",
        "report_receipt.json"
      ]
    }
  ]
}
