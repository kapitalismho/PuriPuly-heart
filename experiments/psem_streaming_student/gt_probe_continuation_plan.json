{
  "schema_version": 1,
  "stages": [
    {
      "id": "prepare",
      "argv": [
        "wsl.exe",
        "-d",
        "Ubuntu",
        "--exec",
        "bash",
        "{workflow_root_wsl}/run_gt_probe.sh",
        "prepare",
        "{workflow_root_wsl}/gt_probe_config.json",
        "{run_root_wsl}"
      ],
      "timeout_seconds": 900,
      "required_outputs": [
        "prepared_fit.pt",
        "prepare_receipt.json"
      ]
    },
    {
      "id": "train",
      "argv": [
        "wsl.exe",
        "-d",
        "Ubuntu",
        "--exec",
        "bash",
        "{workflow_root_wsl}/run_gt_probe.sh",
        "train",
        "{workflow_root_wsl}/gt_probe_config.json",
        "{run_root_wsl}"
      ],
      "timeout_seconds": 5100,
      "required_outputs": [
        "student_gt_checkpoint.pt",
        "train_receipt.json",
        "reload_receipt.json"
      ]
    },
    {
      "id": "report",
      "argv": [
        "wsl.exe",
        "-d",
        "Ubuntu",
        "--exec",
        "bash",
        "{workflow_root_wsl}/run_gt_probe.sh",
        "report",
        "{workflow_root_wsl}/gt_probe_config.json",
        "{run_root_wsl}"
      ],
      "timeout_seconds": 600,
      "required_outputs": [
        "result.json",
        "report_receipt.json"
      ]
    }
  ]
}
