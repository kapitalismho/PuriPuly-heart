    },
    {
     "source": "common_voice",
     "path": "clips/common-voice-17.0/ko/common_voice_ko_35850370.mp3",
     "text": "선비가 이 공장에 들어온 지가 벌써 거의 일년이 되어 온다.",
     "speaker": "A",
     "gap_s": 0.15
    },
    {
     "source": "common_voice",
     "path": "clips/common-voice-17.0/ko/common_voice_ko_36524847.mp3",
