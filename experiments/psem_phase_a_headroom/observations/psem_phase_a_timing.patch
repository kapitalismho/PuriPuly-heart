+    return TRANSCRIBE_ERR_INVALID_ARG;
+#else
+    int stft_threads = n_threads <= 0 ? 1 : n_threads;
+    if (stft_threads > M) {
+        stft_threads = M;
+    }
+    auto worker = [&](int tid) {
+        std::vector<double> frame(2 * static_cast<size_t>(n_fft));
+        for (int ti = tid; ti < M; ti += stft_threads) {
+            const size_t start = static_cast<size_t>(ti) * static_cast<size_t>(hop);
+            for (int k = 0; k < n_fft; ++k) {
+                frame[2 * static_cast<size_t>(k)] = local_padded[start + static_cast<size_t>(k)] * window_[static_cast<size_t>(k)];
+                frame[2 * static_cast<size_t>(k) + 1] = 0.0;
+            }
+            fft_radix2(frame.data(), n_fft);
+            float * pwr_row = power.data() + static_cast<size_t>(ti) * static_cast<size_t>(n_freq);
+            for (int k = 0; k < n_freq; ++k) {
+                const double re = frame[2 * static_cast<size_t>(k)];
+                const double im = frame[2 * static_cast<size_t>(k) + 1];
+                pwr_row[k] = static_cast<float>(re * re + im * im);
+            }
+        }
+    };
+    if (stft_threads <= 1) {
+        worker(0);
+    } else {
+        std::vector<std::thread> pool;
+        pool.reserve(static_cast<size_t>(stft_threads - 1));
+        for (int tid = 1; tid < stft_threads; ++tid) {
+            pool.emplace_back(worker, tid);
+        }
+        worker(0);
+        for (auto & th : pool) {
+            th.join();
+        }
+    }
+#endif
+    std::vector<float> log_mel(static_cast<size_t>(n_mels) * static_cast<size_t>(M));
