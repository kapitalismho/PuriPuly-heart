+transcribe_status MelFrontend::compute_window(const float *        pcm,
+                                              size_t               n_samples,
+                                              int                  win_lo,
+                                              int                  win_hi,
+                                              std::vector<float> & out_mel_window,
+                                              int                  n_threads) const {
+    if (pcm == nullptr) {
+        return TRANSCRIBE_ERR_INVALID_ARG;
+    }
+    const int  n_fft  = cfg_.n_fft;
+    const int  hop    = cfg_.hop_length;
+    const int  n_mels = cfg_.num_mels;
+    const int  n_freq = n_freq_;
+    const int  pad    = n_fft / 2;
+    const bool no_pad = (cfg_.pad_mode == "none");
+    if (no_pad) {
+        return TRANSCRIBE_ERR_INVALID_ARG;
+    }
+    if (cfg_.pad_mode != "constant") {
+        return TRANSCRIBE_ERR_INVALID_ARG;
+    }
+    if (cfg_.normalize != "none") {
+        return TRANSCRIBE_ERR_INVALID_ARG;
+    }
+    const bool n_fft_is_pow2 = ((n_fft > 0) && ((n_fft & (n_fft - 1)) == 0));
+    if (!n_fft_is_pow2) {
+        return TRANSCRIBE_ERR_INVALID_ARG;
+    }
+    const int feat_len = n_frames_for(n_samples);
+    if (win_lo < 0 || win_hi <= win_lo || win_hi > feat_len) {
+        return TRANSCRIBE_ERR_INVALID_ARG;
+    }
+    const int M = win_hi - win_lo;
+    const long emph_lo = static_cast<long>(win_lo) * hop - pad;
+    const long emph_hi = static_cast<long>(win_hi - 1) * hop + pad;
+    const size_t local_len = static_cast<size_t>(M - 1) * static_cast<size_t>(hop) + static_cast<size_t>(n_fft);
+    std::vector<double> local_padded(local_len, 0.0);
+    const double alpha = static_cast<double>(cfg_.pre_emphasis);
+    long i0 = emph_lo < 0 ? 0 : emph_lo;
+    long i1 = emph_hi > static_cast<long>(n_samples) ? static_cast<long>(n_samples) : emph_hi;
+    for (long i = i0; i < i1; ++i) {
+        double e;
+        if (i == 0) {
+            e = static_cast<double>(pcm[0]);
+        } else {
+            e = static_cast<double>(pcm[static_cast<size_t>(i)]) -
+                alpha * static_cast<double>(pcm[static_cast<size_t>(i) - 1]);
+        }
+        const long global_padded = i + pad;
+        const long local_idx = global_padded - static_cast<long>(win_lo) * hop;
+        if (local_idx >= 0 && static_cast<size_t>(local_idx) < local_len) {
+            local_padded[static_cast<size_t>(local_idx)] = e;
+        }
