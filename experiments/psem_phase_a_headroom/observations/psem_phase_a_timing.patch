+                    log_mel[static_cast<size_t>(m) * static_cast<size_t>(M) + static_cast<size_t>(ti)] = 0.0f;
+                }
+            }
+        }
+    }
+    out_mel_window = std::move(log_mel);
+    return TRANSCRIBE_OK;
+}
 
