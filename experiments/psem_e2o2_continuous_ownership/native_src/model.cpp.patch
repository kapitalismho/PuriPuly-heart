+static int64_t psem_env_i64(const char * key, int64_t defv) {
+    const char * v = std::getenv(key);
+    if (v == nullptr || v[0] == '\0') {
+        return defv;
+    }
+    return std::strtoll(v, nullptr, 10);
+}
+
+static int64_t psem_qpc() {
+#ifdef _WIN32
+    LARGE_INTEGER c;
+    QueryPerformanceCounter(&c);
+    return c.QuadPart;
+#else
+    return ggml_time_us();
+#endif
+}
+
+static int64_t psem_qpf() {
+#ifdef _WIN32
+    LARGE_INTEGER f;
+    QueryPerformanceFrequency(&f);
+    return f.QuadPart;
+#else
+    return 1000000;
+#endif
+}
+
+struct PsemEventSock {
+#ifdef _WIN32
+    SOCKET fd = INVALID_SOCKET;
+    bool wsa = false;
+#else
+    int fd = -1;
+#endif
+    bool ok = false;
+
+    ~PsemEventSock() { close_sock(); }
+
+    void close_sock() {
+#ifdef _WIN32
+        if (fd != INVALID_SOCKET) {
+            closesocket(fd);
+            fd = INVALID_SOCKET;
+        }
+        if (wsa) {
+            WSACleanup();
+            wsa = false;
+        }
+#endif
+        ok = false;
+    }
+
+    bool connect_env() {
+        const char * spec = std::getenv("TRANSCRIBE_PSEM_EVENTS_TCP");
+        if (spec == nullptr || spec[0] == '\0') {
+            return false;
+        }
+        std::string host = "127.0.0.1";
+        int port = 0;
+        const char * colon = std::strrchr(spec, ':');
+        if (colon == nullptr) {
+            return false;
+        }
+        host.assign(spec, colon);
+        port = std::atoi(colon + 1);
+        if (port <= 0) {
+            return false;
+        }
+#ifdef _WIN32
+        WSADATA wd;
+        if (WSAStartup(MAKEWORD(2, 2), &wd) != 0) {
+            return false;
+        }
+        wsa = true;
+        fd = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+        if (fd == INVALID_SOCKET) {
+            return false;
+        }
+        sockaddr_in addr{};
+        addr.sin_family = AF_INET;
+        addr.sin_port = htons(static_cast<u_short>(port));
+        if (inet_pton(AF_INET, host.c_str(), &addr.sin_addr) != 1) {
+            return false;
+        }
+        for (int attempt = 0; attempt < 400; ++attempt) {
+            if (connect(fd, reinterpret_cast<sockaddr *>(&addr), sizeof(addr)) == 0) {
+                ok = true;
+                return true;
+            }
+            Sleep(25);
+        }
+#endif
+        return false;
+    }
+
+    bool send_line(const std::string & line) {
+        if (!ok) {
+            return false;
+        }
+        std::string msg = line;
+        if (msg.empty() || msg.back() != '\n') {
+            msg.push_back('\n');
+        }
+        const char * p = msg.data();
+        size_t left = msg.size();
+#ifdef _WIN32
+        while (left > 0) {
+            int n = send(fd, p, static_cast<int>(left), 0);
+            if (n <= 0) {
+                ok = false;
+                return false;
+            }
+            p += n;
+            left -= static_cast<size_t>(n);
+        }
+        return true;
+#else
+        (void)p;
+        (void)left;
+        return false;
+#endif
+    }
+};
+
+static void psem_wait_qpc(int64_t target) {
+    for (;;) {
+        const int64_t now = psem_qpc();
+        if (now >= target) {
+            return;
+        }
+#ifdef _WIN32
+        const int64_t freq = psem_qpf();
+        const int64_t remain = target - now;
+        if (remain > freq / 200) {
+            Sleep(1);
+        } else {
+            Sleep(0);
+        }
+#endif
+    }
+}
