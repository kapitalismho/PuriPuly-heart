import importlib.util
import json
import os
import sys
import traceback
import types
from pathlib import Path

from puripuly_heart.runtime_layout import current_runtime_layout

_MAX_ERROR_BYTES = 65536
_layout = current_runtime_layout()
_native_stdout = sys.stdout
_native_stderr = sys.stderr


def _bounded_exception(exc):
    identity = (
        f"{type(exc).__module__}.{type(exc).__qualname__}: "
        "embedded bootstrap failed\n"
    ).encode("utf-8", errors="replace")
    frames = "".join(traceback.format_tb(exc.__traceback__)[-20:]).encode(
        "utf-8", errors="replace"
    )
    exception = "".join(traceback.format_exception_only(type(exc), exc)).encode(
        "utf-8", errors="replace"
    )
    marker = b"\n... bounded native bootstrap diagnostic ...\n"
    frame_budget = min(32768, _MAX_ERROR_BYTES - len(identity) - len(marker))
    retained_frames = frames[-frame_budget:]
    remaining = _MAX_ERROR_BYTES - len(identity) - len(retained_frames)
    if len(exception) > remaining:
        remaining -= len(marker)
        payload = identity + retained_frames + marker + exception[-remaining:]
    else:
        payload = identity + retained_frames + exception
    return payload[:_MAX_ERROR_BYTES].decode("utf-8", errors="ignore")


def _run_module_as_main(module_name):
    spec = importlib.util.find_spec(module_name)
    if spec is None:
        raise ImportError("module %r not found" % module_name)
    if spec.submodule_search_locations is not None:
        module_name += ".__main__"
        spec = importlib.util.find_spec(module_name)
        if spec is None:
            raise ImportError("package entry point %r not found" % module_name)
    if spec.loader is None or not hasattr(spec.loader, "get_code"):
        raise ImportError("module %r cannot be executed" % module_name)
    code = spec.loader.get_code(spec.name)
    if code is None:
        raise ImportError("module %r has no executable code" % module_name)
    main = types.ModuleType("__main__")
    main.__dict__.update(
        __spec__=spec,
        __file__=spec.origin,
        __cached__=spec.cached,
        __loader__=spec.loader,
        __package__=spec.parent,
        __builtins__=__builtins__,
    )
    sys.modules["__main__"] = main
    sys.modules["__mp_main__"] = main
    os.environ.pop("PYTHONINSPECT", None)
    exec(code, main.__dict__)


exit_code = 0
error_tail = ""
try:
    import certifi
    import dart_bridge

    os.environ["REQUESTS_CA_BUNDLE"] = certifi.where()
    os.environ["OPENBLAS_NUM_THREADS"] = "1"
    os.environ["SSL_CERT_FILE"] = certifi.where()
    sys.argv = {argv}
    sys.executable = {host_executable}
    sys._base_executable = {host_executable}
    _run_module_as_main({module_name})
except SystemExit as exc:
    if exc.code is None:
        exit_code = 0
    elif isinstance(exc.code, int):
        exit_code = exc.code
    else:
        print(exc.code, file=sys.stderr)
        exit_code = 1
except BaseException as exc:
    error_tail = _bounded_exception(exc)
    try:
        _native_stderr.write(error_tail)
        _native_stderr.flush()
    except Exception:
        pass
    exit_code = {error_exit_code}
finally:
    sys.stdout = _native_stdout
    sys.stderr = _native_stderr
    if error_tail:
        try:
            _layout.log_root.mkdir(parents=True, exist_ok=True)
            error_path = _layout.log_root / "native-bootstrap-error.log"
            error_path.write_bytes(error_tail.encode("utf-8"))
        except OSError:
            pass
    payload = json.dumps(
        {"code": exit_code, "error": error_tail},
        ensure_ascii=False,
        separators=(",", ":"),
    ).encode("utf-8")
    dart_bridge.send_bytes(int(os.environ["FLET_DART_BRIDGE_EXIT_PORT"]), payload)
