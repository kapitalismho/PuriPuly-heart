 "sentences": [
  {
   "start_s": 0.0,
   "end_s": 1.9,
   "text": "여러분 안녕하세요 살집채널 박대표입니다"
  },
  {
   "start_s": 1.9,
   "end_s": 4.7,
   "text": "안녕하세요 월용이입니다 오랜만에 뵙습니다"
  },
  {
   "start_s": 4.7,
   "end_s": 7.57,
   "text": "오늘도 여러분들이 선택해주신 단지가"
  },
  {
   "start_s": 7.57,
   "end_s": 10.64,
   "text": "원래는 검단이었는데 ㅎㅎ"
  },
  {
   "start_s": 10.64,
   "end_s": 11.77,
   "text": "검단 말고"
  },
  {
   "start_s": 11.77,
   "end_s": 13.04,
   "text": "미아를 하게 됐습니다"
  },
  {
   "start_s": 13.04,
   "end_s": 14.98,
   "text": "왜 미아죠? 검단 왜 안하죠 저희?"
  },
  {
   "start_s": 14.98,
   "end_s": 19.11,
   "text": "검단보니까 아직 그 상품설명 홈페이지가 오픈이 안 됐어요"
  },
  {
   "start_s": 19.11,
   "end_s": 21.95,
   "text": "평면도하고 단지 배치도, 동호수 배치도 안 나왔습니다"
  },
  {
   "start_s": 21.95,
   "end_s": 23.89,
   "text": "청약일정이 뒤에 있다 보니까"
  },
  {
   "start_s": 23.89,
   "end_s": 25.39,
   "text": "아무래도 조금 늦게 나오는 것 같아요"
  },
  {
   "start_s": 25.39,
   "end_s": 27.76,
   "text": "그래서 이번에는 미아를 먼저하고"
  },
  {
   "start_s": 27.76,
   "end_s": 29.39,
   "text": "다음 주에 검단을 하도록 하겠습니다"
  },
  {
   "start_s": 32.43,
   "end_s": 36.56,
   "text": "이번에도 가장 많이 이야기하는 것들이 분양가입니다"
  },
  {
   "start_s": 36.56,
   "end_s": 38.3,
   "text": "이것 심한 거 아니냐?"
  },
  {
   "start_s": 38.3,
   "end_s": 42.4,
   "text": "심하다! 심하죠! 예 심하죠 ㅎㅎ 줍줍 나올 것 같다"
  },
  {
   "start_s": 42.4,
   "end_s": 45.44,
   "text": "차라리 이곳 이 돈이면 구축 매수하겠다"
  },
  {
   "start_s": 45.44,
   "end_s": 46.88,
   "text": "이런 의견들이 있었고요"
  },
  {
   "start_s": 46.88,
   "end_s": 48.64,
   "text": "실거주도 이야기가 많으세요"
  },
  {
   "start_s": 48.64,
   "end_s": 50.35,
   "text": "왜냐면은 영상 보고"
  },
  {
   "start_s": 50.35,
   "end_s": 53.31,
   "text": "실제로 갔다 왔더니 생각했던 것보다 더 실망했다"
  },
  {
   "start_s": 53.31,
   "end_s": 55.55,
   "text": "일단 부지가 작죠 예 부지도 작고"
  },
  {
   "start_s": 55.55,
   "end_s": 59.59,
   "text": "그리고 그 일대가 아직은 좀 정비가 많이 덜 됐잖아요"
  },
  {
   "start_s": 59.59,
   "end_s": 62.86,
   "text": "그러다 보니까 그런 것들 때문에 실망하신 의견도 꽤 있었어요"
  },
  {
   "start_s": 62.86,
   "end_s": 68.16,
   "text": "마지막으로 그럼에도 불구하고 되고 싶으신 분들이 꽤 있습니다"
  },
  {
   "start_s": 68.16,
   "end_s": 69.2,
   "text": "항상 그렇지만"
  },
  {
   "start_s": 69.2,
   "end_s": 70.1,
   "text": "그런 분들은 어떻게 하면"
  },
  {
   "start_s": 70.1,
   "end_s": 72.0,
   "text": "되는지까지 살펴보도록 할게요"
  },
  {
   "start_s": 72.0,
   "end_s": 73.03,
   "text": "조감도 인데요"
  },
  {
   "start_s": 73.03,
   "end_s": 75.34,
   "text": "잘 그렸어요 잘 그렸다는 게 무슨 말이에요?"
  },
  {
   "start_s": 75.34,
   "end_s": 78.61,
   "text": "이렇게 이게 저는 눈에 띄거든요"
  },
  {
   "start_s": 78.61,
   "end_s": 81.38,
   "text": "중간에? 천장을 뚫어놔서"
  },
  {
   "start_s": 81.38,
   "end_s": 86.45,
   "text": "상업지구, 밑에 뭔가 근린생활시설이 많이 있다"
  },
  {
   "start_s": 86.45,
   "end_s": 87.22,
   "text": "쇼핑하고 싶다"
  },
  {
   "start_s": 87.22,
   "end_s": 88.68,
   "text": "루브르 박물관 가면 그 피라미드 있잖아요?"
  },
  {
   "start_s": 88.68,
   "end_s": 90.62,
   "text": "유리 피라미드 그런 느낌으로"
  },
  {
   "start_s": 90.62,
   "end_s": 93.56,
   "text": "이제 위에서 봤을 때 볼 수 있게 그렇죠"
  },
  {
   "start_s": 93.56,
   "end_s": 97.39,
   "text": "그래서 대표적인 상업시설도 보면 돔형식으로도 돼 있고"
  },
  {
   "start_s": 97.39,
   "end_s": 100.86,
   "text": "여기는 좀 아직까진 뚫어놨는데 일단은 예쁘다"
  },
  {
   "start_s": 100.86,
   "end_s": 104.1,
   "text": "비용이 다 맞는 그런 구조가 보네요 ㅎㅎ 그렇죠 ㅎㅎ"
  },
  {
   "start_s": 104.1,
   "end_s": 105.77,
   "text": "그래서 큰 수정이나 분수같은 거"
  },
  {
   "start_s": 105.77,
   "end_s": 107.9,
   "text": "세워 두기도 하더라고요"
  },
  {
   "start_s": 107.9,
   "end_s": 111.37,
   "text": "근데 여기가 주상복합이다 보니까 용적률 이런 거 가지고"
  },
  {
   "start_s": 111.37,
   "end_s": 112.64,
   "text": "얘기가 좀 많이 있습니다"
  },
  {
   "start_s": 112.64,
   "end_s": 114.31,
   "text": "그렇죠 저희가 확인해 보니까"
  },
  {
   "start_s": 114.31,
   "end_s": 116.95,
   "text": "준주거지역이라서 어쩔 수 없죠"
  },
  {
   "start_s": 116.95,
   "end_s": 121.52,
   "text": "초역세권에다가 원래 역세권에 오피스텔, 주상복합, 빌딩도 많잖아요"
  },
  {
   "start_s": 121.52,
   "end_s": 122.78,
   "text": "세대수가 좀 작은 것도"
  },
  {
   "start_s": 122.78,
   "end_s": 125.0,
   "text": "단점이라고 얘길 하시는 분들이 있는데"
  }
 ]
}