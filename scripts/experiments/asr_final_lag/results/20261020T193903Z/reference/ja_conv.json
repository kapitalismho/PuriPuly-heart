   "text": "そう！"
  },
  {
   "start_s": 21.96,
   "end_s": 22.46,
   "text": "確かに！"
  },
  {
   "start_s": 22.46,
   "end_s": 25.46,
   "text": "うん、なんか、メインと同じ挨拶だとちょっと違うじゃん！"
  },
  {
   "start_s": 25.46,
   "end_s": 27.46,
   "text": "いや、それはすごい思ってたんだよ！"
  },
  {
   "start_s": 27.46,
   "end_s": 30.58,
   "text": "ってか、差別化というか、同じじゃんってなっちゃうから"
  },
  {
   "start_s": 30.58,
   "end_s": 31.24,
   "text": "そう。"
  },
  {
   "start_s": 31.24,
   "end_s": 36.47,
   "text": "見る人がさ、「あこれ、サブちゃんなんだな」って、出だしでわかった方がいいよね！"
  },
  {
   "start_s": 36.47,
   "end_s": 36.97,
   "text": "そう！"
  },
  {
   "start_s": 37.06,
   "end_s": 38.06,
   "text": "はいどうもは絶対やめたほうがいいよ"
  },
  {
   "start_s": 38.06,
   "end_s": 40.06,
   "text": "俺ら、分かりづらいよね"
  },
  {
   "start_s": 40.06,
   "end_s": 46.02,
   "text": "一緒じゃん、って。あ、これサブ⇧っつサブチャンなんだって後から思っちゃったら意味ないから。 そう！"
  },
  {
   "start_s": 47.48,
   "end_s": 48.22,
   "text": "どうしよっかな。"
  },
  {
